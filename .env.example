# Flowdow Environment Configuration

# Django Core Settings
DEBUG=True
SECRET_KEY=change-this-in-production-to-a-secure-random-key-with-min-50-characters
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=flowdow
DB_USER=flowdow
DB_PASSWORD=flowdow_secure_password
DB_HOST=localhost
DB_PORT=5432

# Application Settings
FLOWDOW_ORGANIZATION_NAME=Flowdow Workspace
FLOWDOW_DEFAULT_PAGE_SIZE=25

# Media & Storage Settings
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

